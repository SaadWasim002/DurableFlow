                  "pm.test(\"HTTP 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "DAG walkthrough",
      "description": "root -> [left, right] -> join. Run requests in order and repeat Get DAG run until SUCCEEDED. The join attempt shows resolved branch outputs.",
      "item": [
        {
          "name": "Create DAG workflow",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/workflows",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"diamond-demo-{{$guid}}\",\n  \"version\": 1,\n  \"tasks\": [\n    {\n      \"id\": \"root\",\n      \"type\": \"echo\",\n      \"input\": {\n        \"$ref\": \"run.input\"\n      }\n    },\n    {\n      \"id\": \"left\",\n      \"type\": \"echo\",\n      \"dependsOn\": [\n        \"root\"\n      ],\n      \"input\": {\n        \"branch\": \"left\",\n        \"source\": {\n          \"$ref\": \"root.output\"\n        }\n      }\n    },\n    {\n      \"id\": \"right\",\n      \"type\": \"echo\",\n      \"dependsOn\": [\n        \"root\"\n      ],\n      \"input\": {\n        \"branch\": \"right\",\n        \"source\": {\n          \"$ref\": \"root.output\"\n        }\n      }\n    },\n    {\n      \"id\": \"join\",\n      \"type\": \"echo\",\n      \"dependsOn\": [\n        \"left\",\n        \"right\"\n      ],\n      \"input\": {\n        \"left\": {\n          \"$ref\": \"left.output\"\n        },\n        \"right\": {\n          \"$ref\": \"right.output\"\n        },\n        \"original\": {\n          \"$ref\": \"root.output\"\n        }\n      }\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "if (pm.response.code === 201) {",
                  "    pm.collectionVariables.set(\"dagWorkflowId\", pm.response.json().id);",
                  "    pm.collectionVariables.unset(\"dagRunId\");",
                  "    pm.collectionVariables.unset(\"dagTaskId\");",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Get DAG workflow",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/workflows/{{dagWorkflowId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Create DAG run",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/workflows/{{dagWorkflowId}}/runs",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"input\": {\n    \"reportName\": \"demo\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 202\", function () {",
