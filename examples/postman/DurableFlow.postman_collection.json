    {
      "name": "DAG failure walkthrough",
      "description": "The left branch fails; the ready right branch and pending join are skipped. Repeat Get failed DAG run until FAILED.",
      "item": [
        {
          "name": "Create failing DAG workflow",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/workflows",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"failing-dag-demo-{{$guid}}\",\n  \"version\": 1,\n  \"tasks\": [\n    {\n      \"id\": \"root\",\n      \"type\": \"echo\"\n    },\n    {\n      \"id\": \"left\",\n      \"type\": \"fail\",\n      \"dependsOn\": [\n        \"root\"\n      ],\n      \"input\": {\n        \"message\": \"Left branch failed\"\n      }\n    },\n    {\n      \"id\": \"right\",\n      \"type\": \"echo\",\n      \"dependsOn\": [\n        \"root\"\n      ]\n    },\n    {\n      \"id\": \"join\",\n      \"type\": \"echo\",\n      \"dependsOn\": [\n        \"left\",\n        \"right\"\n      ]\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
