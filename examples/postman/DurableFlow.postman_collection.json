{
  "info": {
    "name": "DurableFlow — Local API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Start local PostgreSQL and DurableFlow, then run requests in order. Successful responses save IDs automatically. Workflow names are unique. The worker executes tasks asynchronously; repeat Get run until SUCCEEDED or FAILED, then inspect attempts. The failure demo saves separate IDs. No authentication required. DAG folders demonstrate branching dependencies with one sequential worker. A join waits for every parent to succeed."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8080",
      "type": "string"
    },
    {
      "key": "workflowId",
      "value": "",
      "type": "string"
    },
    {
      "key": "runId",
      "value": "",
      "type": "string"
    },
    {
      "key": "taskId",
