                  "});",
                  "if (pm.response.code === 202) {",
                  "    const run = pm.response.json();",
                  "    pm.collectionVariables.set(\"dagRunId\", run.id);",
                  "    const task = run.tasks.find(item => item.taskKey === \"join\");",
