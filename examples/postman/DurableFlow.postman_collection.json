    {
      "name": "Success walkthrough",
      "item": [
        {
          "name": "Create workflow",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"report-demo-{{$guid}}\",\n  \"version\": 1,\n  \"tasks\": [\n    {\n      \"id\": \"prepare\",\n      \"type\": \"echo\",\n      \"input\": {\n        \"message\": \"Hello DurableFlow\"\n      }\n    },\n    {\n      \"id\": \"format\",\n      \"type\": \"echo\",\n      \"dependsOn\": [\n        \"prepare\"\n      ],\n      \"input\": {\n        \"previous\": {\n          \"$ref\": \"prepare.output\"\n        }\n      }\n    },\n    {\n      \"id\": \"save\",\n      \"type\": \"echo\",\n      \"dependsOn\": [\n        \"format\"\n      ],\n      \"input\": {\n        \"previous\": {\n          \"$ref\": \"format.output\"\n        }\n      }\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/workflows"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "if (pm.response.code === 201) {",
                  "    pm.collectionVariables.set(\"workflowId\", pm.response.json().id);",
                  "    pm.collectionVariables.unset(\"runId\");",
                  "    pm.collectionVariables.unset(\"taskId\");",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Get workflow",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/workflows/{{workflowId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Create run",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"input\": {\n    \"reportName\": \"demo\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/workflows/{{workflowId}}/runs"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 202\", function () {",
                  "    pm.response.to.have.status(202);",
                  "});",
                  "if (pm.response.code === 202) {",
                  "    const run = pm.response.json();",
                  "    pm.collectionVariables.set(\"runId\", run.id);",
                  "    pm.collectionVariables.unset(\"taskId\");",
                  "    if (run.tasks.length > 0) pm.collectionVariables.set(\"taskId\", run.tasks[0].id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Get run",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/runs/{{runId}}",
            "description": "Repeat until status is SUCCEEDED or FAILED."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get run tasks",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/runs/{{runId}}/tasks"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "if (pm.response.code === 200) {",
                  "    const tasks = pm.response.json();",
                  "    if (tasks.length > 0) pm.collectionVariables.set(\"taskId\", tasks[0].id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Get task attempts",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/tasks/{{taskId}}/attempts"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Failure walkthrough",
      "description": "Run requests in order. Repeat Get failed run until FAILED. Expect prepare SUCCEEDED, format FAILED, save SKIPPED. The failed attempt shows DEMO_FAILURE.",
      "item": [
        {
          "name": "Create failing workflow",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/workflows",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"failure-demo-{{$guid}}\",\n  \"version\": 1,\n  \"tasks\": [\n    {\n      \"id\": \"prepare\",\n      \"type\": \"echo\",\n      \"input\": {\n        \"message\": \"Prepare report\"\n      }\n    },\n    {\n      \"id\": \"format\",\n      \"type\": \"fail\",\n      \"dependsOn\": [\n        \"prepare\"\n      ],\n      \"input\": {\n        \"message\": \"Demo formatting failure\"\n      }\n    },\n    {\n      \"id\": \"save\",\n      \"type\": \"echo\",\n      \"dependsOn\": [\n        \"format\"\n      ],\n      \"input\": {\n        \"previous\": {\n          \"$ref\": \"format.output\"\n        }\n      }\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "if (pm.response.code === 201) {",
                  "    pm.collectionVariables.set(\"failureWorkflowId\", pm.response.json().id);",
                  "    pm.collectionVariables.unset(\"failureRunId\");",
                  "    pm.collectionVariables.unset(\"failureTaskId\");",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Create failing run",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/workflows/{{failureWorkflowId}}/runs",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"input\": {}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 202\", function () {",
                  "    pm.response.to.have.status(202);",
                  "});",
                  "if (pm.response.code === 202) {",
                  "    const run = pm.response.json();",
                  "    pm.collectionVariables.set(\"failureRunId\", run.id);",
                  "    const task = run.tasks.find(item => item.taskKey === \"format\");",
                  "    if (task) pm.collectionVariables.set(\"failureTaskId\", task.id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Get failed run",
          "request": {
